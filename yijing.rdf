    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Bi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <guaci>吉。原筮，元永贞，无咎。不宁方来，后夫凶。</guaci>
        <lines>	010000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</sequence>
        <symbol>䷇</symbol>
        <tuanci>比，吉也；比，辅也，下顺从也。原筮元永贞无咎，以刚中也。不宁方来，上下应也。后夫凶，其道穷也。</tuanci>
        <xiangci>地上有水，比；先王以建万国，亲诸侯。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_比</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <guaci>亨。小利有攸往。</guaci>
        <lines>	100101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</sequence>
        <symbol>䷕</symbol>
        <tuanci>贲，亨，柔来而文刚，故亨。分刚上而文柔，故小利有攸往，天文也。文明以止，人文也。观乎天文，以察时变；观乎人文，以化成天下。</tuanci>
        <xiangci>山下有火，贲；君子以明庶政，无敢折狱。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_贲</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Bo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <guaci>不利有攸往。</guaci>
        <lines>	100000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</sequence>
        <symbol>䷖</symbol>
        <tuanci>剥，剥也，柔变刚也。不利有攸往，小人长也。顺而止之，观象也。君子尚消息盈虚，天行也。</tuanci>
        <xiangci>山附于地，剥；上以厚下安宅。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_剥</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Cui -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <guaci>亨。王假有庙，利见大人，亨，利贞。用大牲吉，利有攸往。</guaci>
        <lines>	011000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</sequence>
        <symbol>䷬</symbol>
        <tuanci>萃，聚也。顺以说，刚中而应，故聚也。王假有庙，致孝享也。利见大人亨，聚以正也。用大牲吉，利有攸往，顺天命也。观其所聚，而天地万物之情可见矣。</tuanci>
        <xiangci>泽上于地，萃；君子以除戎器，戒不虞。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_萃</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <guaci>栋桡。利有攸往，亨。</guaci>
        <lines>	011110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</sequence>
        <symbol>䷛</symbol>
        <tuanci>大过，大者过也。栋桡，本末弱也。刚过而中，巽而说行，利有攸往，乃亨。大过之时大矣哉！</tuanci>
        <xiangci>泽灭木，大过；君子以独立不惧，遁世无闷。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_大过</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <guaci>利贞。不家食吉，利涉大川。</guaci>
        <lines>	100111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</sequence>
        <symbol>䷙</symbol>
        <tuanci>大畜，刚健笃实辉光，日新其德。刚上而尚贤，能止健，大正也。不家食吉，养贤也。利涉大川，应乎天也。</tuanci>
        <xiangci>天在山中，大畜；君子以多识前言往行，以畜其德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_大畜</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <guaci>元亨。</guaci>
        <lines>	101111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</sequence>
        <symbol>䷍</symbol>
        <tuanci>大有，柔得尊位大中，而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以元亨。</tuanci>
        <xiangci>火在天上，大有；君子以遏恶扬善，顺天休命。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_大有</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <guaci>利贞。</guaci>
        <lines>	001111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</sequence>
        <symbol>䷡</symbol>
        <tuanci>大壮，大者壮也。刚以动，故壮。大壮利贞，大者正也。正大而天地之情可见矣。</tuanci>
        <xiangci>雷在天上，大壮；君子以非礼弗履。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_大壮</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Ding -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <guaci>元吉，亨。</guaci>
        <lines>	101110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</sequence>
        <symbol>䷱</symbol>
        <tuanci>鼎，象也。以木巽火，亨饪也。圣人亨以享上帝，而大亨以养圣贤。巽而耳目聪明，柔进而上行，得中而应乎刚，是以元亨。</tuanci>
        <xiangci>木上有火，鼎；君子以正位凝命。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_鼎</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Dui -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <guaci>亨，利贞。</guaci>
        <lines>	011011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58</sequence>
        <symbol>䷹</symbol>
        <tuanci>兑，说也。刚中而柔外，说以利贞，是以顺乎天而应乎人。说以先民，民忘其劳；说以犯难，民忘其死。说之大，民劝矣哉！</tuanci>
        <xiangci>丽泽，兑；君子以朋友讲习。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_兑</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Dun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <guaci>亨，小利贞。</guaci>
        <lines>	111100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</sequence>
        <symbol>䷠</symbol>
        <tuanci>遁亨，遁而亨也。刚当位而应，与时行也。小利贞，浸而长也。遁之时义大矣哉！</tuanci>
        <xiangci>天下有山，遁；君子以远小人，不恶而严。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_遁</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Feng -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <guaci>亨，王假之，勿忧，宜日中。</guaci>
        <lines>	001101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55</sequence>
        <symbol>䷶</symbol>
        <tuanci>丰，大也。明以动，故丰。王假之，尚大也。勿忧宜日中，宜照天下也。日中则昃，月盈则食，天地盈虚，与时消息，而况于人乎？况于鬼神乎？</tuanci>
        <xiangci>雷电皆至，丰；君子以折狱致刑。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_丰</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Fu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <guaci>亨。出入无疾，朋来无咎。反复其道，七日来复。利有攸往。</guaci>
        <lines>	000001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</sequence>
        <symbol>䷗</symbol>
        <tuanci>复亨，刚反，动而以顺行，是以出入无疾，朋来无咎。反复其道，七日来复，天行也。利有攸往，刚长也。复，其见天地之心乎！</tuanci>
        <xiangci>雷在地中，复；先王以至日闭关，商旅不行，后不省方。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_复</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Ge -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <guaci>己日乃孚。元亨利贞，悔亡。</guaci>
        <lines>	011101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">49</sequence>
        <symbol>䷰</symbol>
        <tuanci>革，水火相息，二女同居，其志不相得，曰革。己日乃孚，革而信之。文明以说，大亨以正。革而当，其悔乃亡。天地革而四时成，汤武革命，顺乎天而应乎人。革之时大矣哉！</tuanci>
        <xiangci>泽中有火，革；君子以治历明时。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_革</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Gen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <guaci>艮其背，不获其身；行其庭，不见其人。无咎。</guaci>
        <lines>	100100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">52</sequence>
        <symbol>䷳</symbol>
        <tuanci>艮，止也。时止则止，时行则行，动静不失其时，其道光明。艮其止，止其所也。上下敌应，不相与也。是以不获其身，行其庭不见其人，无咎也。</tuanci>
        <xiangci>兼山，艮；君子以思不出其位。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_艮</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Gou -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <guaci>女壮，勿用取女。</guaci>
        <lines>	111110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44</sequence>
        <symbol>䷫</symbol>
        <tuanci>姤，遇也，柔遇刚也。勿用取女，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉！</tuanci>
        <xiangci>天下有风，姤；后以施命诰四方。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_姤</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Gu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <guaci>元亨，利涉大川。先甲三日，后甲三日。</guaci>
        <lines>	100110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</sequence>
        <symbol>䷑</symbol>
        <tuanci>蛊，刚上而柔下，巽而止，蛊。蛊元亨，而天下治也。利涉大川，往有事也。先甲三日，后甲三日，终则有始，天行也。</tuanci>
        <xiangci>山下有风，蛊；君子以振民育德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_蛊</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Guai -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <guaci>扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。</guaci>
        <lines>	011111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">43</sequence>
        <symbol>䷪</symbol>
        <tuanci>夬，决也，刚决柔也。健而说，决而和。扬于王庭，柔乘五刚也。孚号有厉，其危乃光也。告自邑，不利即戎，所尚乃穷也。利有攸往，刚长乃终也。</tuanci>
        <xiangci>泽上于天，夬；君子以施禄及下，居德则忌。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_夬</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Guan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <guaci>盥而不荐，有孚颙若。</guaci>
        <lines>	110000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</sequence>
        <symbol>䷓</symbol>
        <tuanci>大观在上，顺而巽，中正以观天下。观，盥而不荐，有孚颙若，下观而化也。观天之神道，而四时不忒；圣人以神道设教，而天下服矣。</tuanci>
        <xiangci>风行地上，观；先王以省方观民设教。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_观</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <guaci>征凶，无攸利。</guaci>
        <lines>	001011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">54</sequence>
        <symbol>䷵</symbol>
        <tuanci>归妹，天地之大义也。天地不交，而万物不兴。归妹，人之终始也。说以动，所归妹也。征凶，位不当也。无攸利，柔乘刚也。</tuanci>
        <xiangci>泽上有雷，归妹；君子以永终知敝。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_归妹</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Heng -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <guaci>亨，无咎，利贞。利有攸往。</guaci>
        <lines>	001110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</sequence>
        <symbol>䷟</symbol>
        <tuanci>恒，久也。刚上而柔下，雷风相与，巽而动，刚柔皆应，恒。恒亨无咎利贞，久于其道也。天地之道，恒久而不已也。利有攸往，终则有始也。日月得天而能久照，四时变化而能久成，圣人久于其道而天下化成。观其所恒，而天地万物之情可见矣。</tuanci>
        <xiangci>雷风，恒；君子以立不易方。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_恒</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Huan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <guaci>亨。王假有庙，利涉大川，利贞。</guaci>
        <lines>	110010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">59</sequence>
        <symbol>䷺</symbol>
        <tuanci>涣，亨。刚来而不穷，柔得位乎外而上同。王假有庙，王乃在中也。利涉大川，乘木有功也。</tuanci>
        <xiangci>风行水上，涣；先王以享于帝立庙。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_涣</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <guaci>亨小，利贞。初吉终乱。</guaci>
        <lines>	010101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">63</sequence>
        <symbol>䷾</symbol>
        <tuanci>既济，亨，小者亨也。利贞，刚柔正而位当也。初吉，柔得中也。终止则乱，其道穷也。</tuanci>
        <xiangci>水在火上，既济；君子以思患而豫防之。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_既济</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <guaci>利女贞。</guaci>
        <lines>	110101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</sequence>
        <symbol>䷤</symbol>
        <tuanci>家人，女正位乎内，男正位乎外。男女正，天地之大义也。家人有严君焉，父母之谓也。父父，子子，兄兄，弟弟，夫夫，妇妇，而家道正。正家而天下定矣。</tuanci>
        <xiangci>风自火出，家人；君子以言有物而行有恒。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_家人</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Jian -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <guaci>利西南，不利东北。利见大人，贞吉。</guaci>
        <lines>	010100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39</sequence>
        <symbol>䷦</symbol>
        <tuanci>蹇，难也，险在前也。见险而能止，知矣哉！蹇利西南，往得中也；不利东北，其道穷也。利见大人，往有功也。当位贞吉，以正邦也。蹇之时用大矣哉！</tuanci>
        <xiangci>山上有水，蹇；君子以反身修德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_蹇</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <guaci>女归吉，利贞。</guaci>
        <lines>	110100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">53</sequence>
        <symbol>䷴</symbol>
        <tuanci>渐之进也，女归吉也。进得位，往有功也。进以正，可以正邦也。其位，刚得中也。止而巽，动不穷也。</tuanci>
        <xiangci>山上有木，渐；君子以居贤德善俗。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_渐</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Jie -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <guaci>亨。苦节不可贞。</guaci>
        <lines>	010011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</sequence>
        <symbol>䷻</symbol>
        <tuanci>节，亨，刚柔分而刚得中。苦节不可贞，其道穷也。说以行险，当位以节，中正以通。天地节而四时成。节以制度，不伤财，不害民。</tuanci>
        <xiangci>泽上有水，节；君子以制数度，议德行。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_节</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Jin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <guaci>康侯用锡马蕃庶，昼日三接。</guaci>
        <lines>	101000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</sequence>
        <symbol>䷢</symbol>
        <tuanci>晋，进也。明出地上，顺而丽乎大明，柔进而上行，是以康侯用锡马蕃庶，昼日三接也。</tuanci>
        <xiangci>明出地上，晋；君子以自昭明德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_晋</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Jing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <guaci>改邑不改井，无丧无得，往来井井。汔至亦未繘井，羸其瓶，凶。</guaci>
        <lines>	010110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</sequence>
        <symbol>䷯</symbol>
        <tuanci>巽乎水而上水，井。井养而不穷也。改邑不改井，乃以刚中也。汔至亦未繘井，未有功也。羸其瓶，是以凶也。</tuanci>
        <xiangci>木上有水，井；君子以劳民劝相。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_井</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Kan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <guaci>习坎，有孚，维心亨，行有尚。</guaci>
        <lines>	010010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</sequence>
        <symbol>䷜</symbol>
        <tuanci>习坎，重险也。水流而不盈，行险而不失其信。维心亨，乃以刚中也。行有尚，往有功也。天险不可升也，地险山川丘陵也，王公设险以守其国。险之时用大矣哉！</tuanci>
        <xiangci>水洊至，习坎；君子以常德行，习教事。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_坎</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Kui -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <guaci>小事吉。</guaci>
        <lines>	101011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38</sequence>
        <symbol>䷥</symbol>
        <tuanci>睽，火动而上，泽动而下，二女同居，其志不同行。说而丽乎明，柔进而上行，得中而应乎刚，是以小事吉。天地睽而其事同也，男女睽而其志通也，万物睽而其事类也。睽之时用大矣哉！</tuanci>
        <xiangci>上火下泽，睽；君子以同而异。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_睽</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Kun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_6"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_7"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <guaci>元亨，利牝马之贞。君子有攸往，先迷后得主，利西南得朋，东北丧朋。安贞吉。</guaci>
        <lines>	000000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sequence>
        <symbol>䷁</symbol>
        <tuanci>至哉坤元，万物资生，乃顺承天。坤厚载物，德合无疆。含弘光大，品物咸亨。牝马地类，行地无疆，柔顺利贞。君子攸行，先迷失道，后顺得常。西南得朋，乃与类行；东北丧朋，乃终有庆。安贞之吉，应地无疆。</tuanci>
        <xiangci>地势坤，君子以厚德载物。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_坤</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <guaci>亨，贞，大人吉，无咎。有言不信。</guaci>
        <lines>	011010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">47</sequence>
        <symbol>䷮</symbol>
        <tuanci>困，刚掩也。险以说，困而不失其所亨，其唯君子乎！贞大人吉，以刚中也。有言不信，尚口乃穷也。</tuanci>
        <xiangci>泽无水，困；君子以致命遂志。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_困</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Li -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Li">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <guaci>利贞，亨。畜牝牛，吉。</guaci>
        <lines>	101101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</sequence>
        <symbol>䷝</symbol>
        <tuanci>离，丽也。日月丽乎天，百谷草木丽乎土。重明以丽乎正，乃化成天下。柔丽乎中正，故亨，是以畜牝牛吉也。</tuanci>
        <xiangci>明两作，离；大人以继明照于四方。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_离</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Lin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <guaci>元亨利贞。至于八月有凶。</guaci>
        <lines>	000011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</sequence>
        <symbol>䷒</symbol>
        <tuanci>临，刚浸而长，说而顺，刚中而应。大亨以正，天之道也。至于八月有凶，消不久也。</tuanci>
        <xiangci>泽上有地，临；君子以教思无穷，容保民无疆。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_临</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Lv -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <guaci>履虎尾，不咥人，亨。</guaci>
        <lines>	111011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</sequence>
        <symbol>䷉</symbol>
        <tuanci>履，柔履刚也。说而应乎乾，是以履虎尾，不咥人，亨。刚中正，履帝位而不疚，光明也。</tuanci>
        <xiangci>上天下泽，履；君子以辨上下，定民志。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_履</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <guaci>小亨，旅贞吉。</guaci>
        <lines>	101100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">56</sequence>
        <symbol>䷷</symbol>
        <tuanci>旅，小亨，柔得中乎外而顺乎刚，止而丽乎明，是以小亨旅贞吉也。旅之时义大矣哉！</tuanci>
        <xiangci>山上有火，旅；君子以明慎用刑而不留狱。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_旅</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Meng -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <guaci>亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。</guaci>
        <lines>	100010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sequence>
        <symbol>䷃</symbol>
        <tuanci>蒙，山下有险，险而止，蒙。蒙亨，以亨行时中也。匪我求童蒙，童蒙求我，志应也。初筮告，以刚中也。再三渎，渎则不告，渎蒙也。蒙以养正，圣功也。</tuanci>
        <xiangci>山下出泉，蒙；君子以果行育德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_蒙</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <guaci>利艰贞。</guaci>
        <lines>	000101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</sequence>
        <symbol>䷣</symbol>
        <tuanci>明入地中，明夷。内文明而外柔顺，以蒙大难，文王以之。利艰贞，晦其明也。内难而能正其志，箕子以之。</tuanci>
        <xiangci>明入地中，明夷；君子以莅众，用晦而明。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_明夷</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Pi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <guaci>否之匪人，不利君子贞，大往小来。</guaci>
        <lines>	111000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</sequence>
        <symbol>䷋</symbol>
        <tuanci>否之匪人，不利君子贞，大往小来。则是天地不交而万物不通也，上下不交而天下无邦也。内阴而外阳，内柔而外刚，内小人而外君子，小人道长，君子道消也。</tuanci>
        <xiangci>天地不交，否；君子以俭德辟难，不可荣以禄。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_否</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Qian -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_6"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_7"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <guaci>元亨利贞。</guaci>
        <lines>	111111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sequence>
        <symbol>䷀</symbol>
        <tuanci>大哉乾元，万物资始，乃统天。云行雨施，品物流形。大明终始，六位时成，时乘六龙以御天。乾道变化，各正性命，保合大和，乃利贞。首出庶物，万国咸宁。</tuanci>
        <xiangci>天行健，君子以自强不息。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_乾</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <guaci>亨，君子有终。</guaci>
        <lines>	000100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</sequence>
        <symbol>䷎</symbol>
        <tuanci>谦，亨。天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦尊而光，卑而不可逾，君子之终也。</tuanci>
        <xiangci>地中有山，谦；君子以裒多益寡，称物平施。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_谦</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <guaci>元亨，用见大人，勿恤，南征吉。</guaci>
        <lines>	000110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">46</sequence>
        <symbol>䷭</symbol>
        <tuanci>柔以时升，巽而顺，刚中而应，是以大亨。用见大人，勿恤，有庆也。南征吉，志行也。</tuanci>
        <xiangci>地中生木，升；君子以顺德，积小以高大。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_升</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Shi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <guaci>贞，丈人吉，无咎。</guaci>
        <lines>	000010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</sequence>
        <symbol>䷆</symbol>
        <tuanci>师，众也；贞，正也。能以众正，可以王矣。刚中而应，行险而顺，以此毒天下，而民从之，吉又何咎矣。</tuanci>
        <xiangci>地中有水，师；君子以容民畜众。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_师</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <guaci>亨。利用狱。</guaci>
        <lines>	101001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</sequence>
        <symbol>䷔</symbol>
        <tuanci>颐中有物，曰噬嗑。噬嗑而亨，刚柔分，动而明，雷电合而章。柔得中而上行，虽不当位，利用狱也。</tuanci>
        <xiangci>雷电，噬嗑；先王以明罚敕法。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_噬嗑</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Song -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Song">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <guaci>有孚，窒惕，中吉，终凶。利见大人，不利涉大川。</guaci>
        <lines>	111010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</sequence>
        <symbol>䷅</symbol>
        <tuanci>讼，上刚下险，险而健，讼。讼有孚窒惕，中吉，刚来而得中也。终凶，讼不可成也。利见大人，尚中正也。不利涉大川，入于渊也。</tuanci>
        <xiangci>天与水违行，讼；君子以作事谋始。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_讼</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Sui -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <guaci>元亨利贞，无咎。</guaci>
        <lines>	011001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</sequence>
        <symbol>䷐</symbol>
        <tuanci>随，刚来而下柔，动而说，随。大亨贞，无咎，而天下随时。随时之义大矣哉！</tuanci>
        <xiangci>泽中有雷，随；君子以向晦入宴息。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_随</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Sun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <guaci>有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。</guaci>
        <lines>	100011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">41</sequence>
        <symbol>䷨</symbol>
        <tuanci>损，损下益上，其道上行。损而有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。二簋应有时，损刚益柔有时。损益盈虚，与时偕行。</tuanci>
        <xiangci>山下有泽，损；君子以惩忿窒欲。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_损</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Tai -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <guaci>小往大来，吉亨。</guaci>
        <lines>	000111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</sequence>
        <symbol>䷊</symbol>
        <tuanci>泰，小往大来，吉亨。则是天地交而万物通也，上下交而其志同也。内阳而外阴，内健而外顺，内君子而外小人，君子道长，小人道消也。</tuanci>
        <xiangci>天地交，泰；后以财成天地之道，辅相天地之宜，以左右民。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_泰</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <guaci>同人于野，亨。利涉大川，利君子贞。</guaci>
        <lines>	111101</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</sequence>
        <symbol>䷌</symbol>
        <tuanci>同人，柔得位得中而应乎乾，曰同人。同人曰：同人于野，亨，利涉大川，乾行也。文明以健，中正而应，君子正也。唯君子为能通天下之志。</tuanci>
        <xiangci>天与火，同人；君子以类族辨物。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_同人</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Li"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <guaci>亨。小狐汔济，濡其尾，无攸利。</guaci>
        <lines>	101010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64</sequence>
        <symbol>䷿</symbol>
        <tuanci>未济，亨，柔得中也。小狐汔济，未出中也。濡其尾，无攸利，不续终也。虽不当位，刚柔应也。</tuanci>
        <xiangci>火在水上，未济；君子以慎辨物居方。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_未济</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <guaci>元亨利贞。其匪正有眚，不利有攸往。</guaci>
        <lines>	111001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</sequence>
        <symbol>䷘</symbol>
        <tuanci>无妄，刚自外来而为主于内，动而健，刚中而应。大亨以正，天之命也。其匪正有眚，不利有攸往，无妄之往，何之矣？天命不佑，行矣哉？</tuanci>
        <xiangci>天下雷行，物与无妄；先王以茂对时育万物。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_无妄</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Xian -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <guaci>亨，利贞。取女吉。</guaci>
        <lines>	011100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</sequence>
        <symbol>䷞</symbol>
        <tuanci>咸，感也。柔上而刚下，二气感应以相与。止而说，男下女，是以亨利贞，取女吉也。天地感而万物化生，圣人感人心而天下和平。观其所感，而天地万物之情可见矣。</tuanci>
        <xiangci>山上有泽，咸；君子以虚受人。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_咸</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <guaci>亨，利贞。可小事，不可大事。飞鸟遗之音，不宜上，宜下，大吉。</guaci>
        <lines>	001100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62</sequence>
        <symbol>䷽</symbol>
        <tuanci>小过，小者过而亨也。过以利贞，与时行也。柔得中，是以小事吉也。刚失位而不中，是以不可大事也。有飞鸟之象焉，飞鸟遗之音，不宜上宜下，大吉，上逆而下顺也。</tuanci>
        <xiangci>山上有雷，小过；君子以行过乎恭，丧过乎哀，用过乎俭。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_小过</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <guaci>亨。密云不雨，自我西郊。</guaci>
        <lines>	110111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</sequence>
        <symbol>䷈</symbol>
        <tuanci>小畜，柔得位而上下应之，曰小畜。健而巽，刚中而志行，乃亨。密云不雨，尚往也；自我西郊，施未行也。</tuanci>
        <xiangci>风行天上，小畜；君子以懿文德。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_小畜</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Xie -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <guaci>利西南。无所往，其来复吉。有攸往，夙吉。</guaci>
        <lines>	001010</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</sequence>
        <symbol>䷧</symbol>
        <tuanci>解，险以动，动而免乎险，解。解利西南，往得众也。其来复吉，乃得中也。有攸往夙吉，往有功也。天地解而雷雨作，雷雨作而百果草木皆甲坼。解之时大矣哉！</tuanci>
        <xiangci>雷雨作，解；君子以赦过宥罪。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_解</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Xu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Qian"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <guaci>有孚，光亨，贞吉。利涉大川。</guaci>
        <lines>	010111</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sequence>
        <symbol>䷄</symbol>
        <tuanci>需，须也，险在前也。刚健而不陷，其义不困穷矣。需有孚，光亨贞吉，位乎天位，以正中也。利涉大川，往有功也。</tuanci>
        <xiangci>云上于天，需；君子以饮食宴乐。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_需</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Xun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <guaci>小亨，利有攸往，利见大人。</guaci>
        <lines>	110110</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">57</sequence>
        <symbol>䷸</symbol>
        <tuanci>重巽以申命。刚巽乎中正而志行，柔皆顺乎刚，是以小亨，利有攸往，利见大人。</tuanci>
        <xiangci>随风，巽；君子以申命行事。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_巽</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Yi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Gen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <guaci>贞吉。观颐，自求口实。</guaci>
        <lines>	100001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</sequence>
        <symbol>䷚</symbol>
        <tuanci>颐，贞吉，养正则吉也。观颐，观其所养也；自求口实，观其自养也。天地养万物，圣人养贤以及万民。颐之时大矣哉！</tuanci>
        <xiangci>山下有雷，颐；君子以慎言语，节饮食。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_颐</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <guaci>利有攸往，利涉大川。</guaci>
        <lines>	110001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42</sequence>
        <symbol>䷩</symbol>
        <tuanci>益，损上益下，民说无疆。自上下下，其道大光。利有攸往，中正有庆。利涉大川，木道乃行。益动而巽，日进无疆。天施地生，其益无方。凡益之道，与时偕行。</tuanci>
        <xiangci>风雷，益；君子以见善则迁，有过则改。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_益</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Yu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kun"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <guaci>利建侯行师。</guaci>
        <lines>	001000</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</sequence>
        <symbol>䷏</symbol>
        <tuanci>豫，刚应而志行，顺以动，豫。豫顺以动，故天地如之，而况建侯行师乎？天地以顺动，故日月不过而四时不忒；圣人以顺动，则刑罚清而民服。豫之时义大矣哉！</tuanci>
        <xiangci>雷出地奋，豫；先王以作乐崇德，殷荐之上帝，以配祖考。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_豫</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <guaci>亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。</guaci>
        <lines>	001001</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">51</sequence>
        <symbol>䷲</symbol>
        <tuanci>震，亨。震来虩虩，恐致福也。笑言哑哑，后有则也。震惊百里，惊远而惧迩也。出可以守宗庙社稷，以为祭主也。</tuanci>
        <xiangci>洊雷，震；君子以恐惧修省。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_震</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Dui"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Xun"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <guaci>豚鱼吉，利涉大川，利贞。</guaci>
        <lines>	110011</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">61</sequence>
        <symbol>䷼</symbol>
        <tuanci>中孚，柔在内而刚得中，说而巽，孚乃化邦也。豚鱼吉，信及豚鱼也。利涉大川，乘木舟虚也。中孚以利贞，乃应乎天也。</tuanci>
        <xiangci>泽上有风，中孚；君子以议狱缓死。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_中孚</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Hexagram"/>
        <hasCuoGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <hasLowerTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen"/>
        <hasUpperTrigram rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#t_Kan"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_1"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_2"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_3"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_4"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_5"/>
        <hasYao rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_6"/>
        <hasZongGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <guaci>元亨利贞。勿用有攸往，利建侯。</guaci>
        <lines>	010100</lines>
        <sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sequence>
        <symbol>䷂</symbol>
        <tuanci>屯，刚柔始交而难生，动乎险中，大亨贞。雷雨之动满盈，天造草昧，宜建侯而不宁。</tuanci>
        <xiangci>云雷，屯；君子以经纶。</xiangci>
        <rdfs:label xml:lang="zh">六十四卦_屯</rdfs:label>
    </owl:NamedIndividual>
    


