    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#t_Zhen">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Trigram"/>
        <direction>东</direction>
        <element>木</element>
        <nature>雷</nature>
        <symbol>☳</symbol>
        <virtue>动</virtue>
        <rdfs:label xml:lang="zh">八卦_震</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>贲其趾，舍车而徒。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>舍车而徒，义弗乘也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>贲其须。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>贲其须，与上兴也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>贲如濡如，永贞吉。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>永贞之吉，终莫之陵也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>贲如皤如，白马翰如，匪寇婚媾。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>六四，当位疑也。匪寇婚媾，终无尤也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贲于丘园，束帛戋戋，吝，终吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五之吉，有喜也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>白贲，无咎。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>白贲无咎，上得志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">贲_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>有孚比之，无咎。有孚盈缶，终来有它，吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>比之初六，有它吉也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">比_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>比之自内，贞吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>比之自内，不自失也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">比_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>比之匪人。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>比之匪人，不亦伤乎。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">比_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>外比之，贞吉。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>外比于贤，以从上也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">比_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>显比，王用三驱，失前禽。邑人不诫，吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>显比之吉，位正中也。舍逆取顺，失前禽也。邑人不诫，上使中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">比_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>比之无首，凶。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>比之无首，无所终也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">比_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>剥床以足，蔑贞凶。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>剥床以足，以灭下也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>剥床以辨，蔑贞凶。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>剥床以辨，未有与也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>剥之，无咎。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>剥之无咎，失上下也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>剥床以肤，凶。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>剥床以肤，切近灾也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贯鱼，以宫人宠，无不利。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>以宫人宠，终无尤也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Bo_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Bo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>硕果不食，君子得舆，小人剥庐。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>君子得舆，民所载也。小人剥庐，终不可用也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">剥_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>有孚不终，乃乱乃萃，若号，一握为笑，勿恤，往无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>乃乱乃萃，其志乱也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>引吉，无咎，孚乃利用禴。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>引吉无咎，中未变也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>萃如，嗟如，无攸利，往无咎，小吝。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>往无咎，上巽也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>大吉，无咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>大吉无咎，位不当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>萃有位，无咎。匪孚，元永贞，悔亡。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>萃有位，志未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Cui_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Cui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>赍咨涕洟，无咎。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>赍咨涕洟，未安上也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">萃_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>藉用白茅，无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>藉用白茅，柔在下也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>枯杨生稊，老夫得其女妻，无不利。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>老夫女妻，过以相与也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>栋桡，凶。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>栋桡之凶，不可以有辅也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>栋隆，吉；有它吝。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>栋隆之吉，不桡乎下也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>枯杨生华，老妇得其士夫，无咎无誉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>枯杨生华，何可久也。老妇士夫，亦可丑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaGuo_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>过涉灭顶，凶，无咎。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>过涉之凶，不可咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大过_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>有厉利已。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>有厉利已，不犯灾也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>舆说輹。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>舆说輹，中无尤也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>良马逐，利艰贞。曰闲舆卫，利有攸往。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>利有攸往，上合志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>童牛之牿，元吉。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>六四元吉，有喜也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>豮豕之牙，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五之吉，有庆也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaXu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>何天之衢，亨。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>何天之衢，道大行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大畜_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>无交害，匪咎，艰则无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>大有初九，无交害也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>大车以载，有攸往，无咎。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>大车以载，积中不败也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>公用亨于天子，小人弗克。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>公用亨于天子，小人害也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>匪其彭，无咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>匪其彭无咎，明辨晳也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>厥孚交如，威如，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>厥孚交如，信以发志也。威如之吉，易而无备也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaYou_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaYou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>自天佑之，吉无不利。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>大有上吉，自天佑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大有_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>壮于趾，征凶，有孚。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>壮于趾，其孚穷也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>贞吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二贞吉，以中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>小人用壮，君子罔也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>贞吉悔亡，藩决不羸，壮于大舆之輹。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>藩决不羸，尚往也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>丧羊于易，无悔。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>丧羊于易，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_DaZhuang_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_DaZhuang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>羝羊触藩，不能退，不能遂，无攸利，艰则吉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>不能退，不能遂，不详也。艰则吉，咎不长也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">大壮_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>鼎颠趾，利出否，得妾以其子，无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>鼎颠趾，未悖也。利出否，以从贵也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>鼎有实，我仇有疾，不我能即，吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>鼎有实，慎所之也。我仇有疾，终无尤也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>鼎耳革，其行塞，雉膏不食，方雨亏悔，终吉。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>鼎耳革，失其义也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>鼎折足，覆公餗，其形渥，凶。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>覆公餗，信如何也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>鼎黄耳金铉，利贞。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>鼎黄耳，中以为实也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ding_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ding"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>鼎玉铉，大吉，无不利。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>玉铉在上，刚柔节也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">鼎_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>和兑，吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>和兑之吉，行未疑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>孚兑，吉，悔亡。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>孚兑之吉，信志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>来兑，凶。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>来兑之凶，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>商兑未宁，介疾有喜。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>九四之喜，有庆也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>孚于剥，有厉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>孚于剥，位正当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dui_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>引兑。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>上六引兑，未光也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">兑_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>遁尾，厉，勿用有攸往。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>遁尾之厉，不往何灾也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>执之用黄牛之革，莫之胜说。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>执用黄牛，固志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>系遁，有疾厉，畜臣妾吉。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>系遁之厉，有疾惫也。畜臣妾吉，不可大事也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>好遁，君子吉，小人否。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>君子好遁，小人否也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>嘉遁，贞吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>嘉遁贞吉，以正志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Dun_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Dun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>肥遁，无不利。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>肥遁，无不利，无所疑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">遁_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>遇其配主，虽旬无咎，往有尚。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>虽旬无咎，过旬灾也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>丰其蔀，日中见斗，往得疑疾，有孚发若，吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>有孚发若，信以发志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>丰其沛，日中见沫，折其右肱，无咎。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>丰其沛，不可大事也。折其右肱，终不可用也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>丰其蔀，日中见斗，遇其夷主，吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>丰其蔀，位不当也。日中见斗，幽不明也。遇其夷主，吉行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>来章，有庆誉，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五之吉，有庆也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Feng_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Feng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>丰其屋，天际翔也。窥其户，阒其无人，自藏也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">丰_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>不远复，无祗悔，元吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>不远之复，以修身也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">复_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>休复，吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>休复之吉，以下仁也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">复_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>频复，厉无咎。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>频复之厉，义无咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">复_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>中行独复。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>中行独复，以从道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">复_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>敦复，无悔。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>敦复无悔，中以自考也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">复_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Fu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Fu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>迷复，凶，有灾眚。用行师，终有大败，以其国君，凶；至于十年，不克征。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>迷复之凶，反君道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">复_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>巩用黄牛之革。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>巩用黄牛，不可以有为也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">革_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>己日乃革之，征吉，无咎。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>己日革之，行有嘉也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">革_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>征凶，贞厉，革言三就，有孚。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>革言三就，又何之矣。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">革_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>悔亡，有孚改命，吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>改命之吉，信志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">革_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>大人虎变，未占有孚。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>大人虎变，其文炳也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">革_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Ge_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Ge"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>君子豹变，小人革面，征凶，居贞吉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>君子豹变，其文蔚也。小人革面，顺以从君也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">革_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>艮其趾，无咎，利永贞。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>艮其趾，未失正也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>艮其腓，不拯其随，其心不快。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>不拯其随，未退听也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>艮其限，列其夤，厉薰心。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>艮其限，危薰心也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>艮其身，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>艮其身，止诸躬也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>艮其辅，言有序，悔亡。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>艮其辅，以中正也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gen_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>敦艮，吉。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>敦艮之吉，以厚终也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">艮_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>系于金柅，贞吉，有攸往，见凶，羸豕孚蹢躅。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>系于金柅，柔道牵也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>包有鱼，无咎，不利宾。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>包有鱼，义不及宾也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>臀无肤，其行次且，厉，无大咎。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>其行次且，行未牵也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>包无鱼，起凶。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>无鱼之凶，远民也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>以杞包瓜，含章，有陨自天。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>九五含章，中正也。有陨自天，志不舍命也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gou_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gou"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>姤其角，吝，无咎。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>姤其角，上穷吝也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">姤_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>干父之蛊，有子，考无咎，厉终吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>干父之蛊，意承考也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>干母之蛊，不可贞。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>干母之蛊，得中道也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>干父之蛊，小有悔，无大咎。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>干父之蛊，终无咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>裕父之蛊，往见吝。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>裕父之蛊，往未得也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>干父之蛊，用誉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>干父用誉，承以德也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Gu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Gu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>不事王侯，高尚其事。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>不事王侯，志可则也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蛊_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>壮于前趾，往不胜为咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>不胜而往，咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>惕号，莫夜有戎，勿恤。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>有戎勿恤，得中道也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>壮于頄，有凶。君子夬夬，独行遇雨，若濡有愠，无咎。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>君子夬夬，终无咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>臀无肤，其行次且。牵羊悔亡，闻言不信。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>其行次且，位不当也。闻言不信，聪不明也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>苋陆夬夬，中行无咎。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>中行无咎，中未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guai_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>无号，终有凶。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>无号之凶，终不可长也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">夬_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>童观，小人无咎，君子吝。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>初六童观，小人道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">观_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>窥观，利女贞。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>窥观女贞，亦可丑也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">观_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>观我生，进退。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>观我生进退，未失道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">观_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>观国之光，利用宾于王。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>观国之光，尚宾也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">观_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>观我生，君子无咎。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>观我生，观民也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">观_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Guan_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Guan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>观其生，君子无咎。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>观其生，志未平也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">观_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>归妹以娣，跛能履，征吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>归妹以娣，以恒也。跛能履吉，相承也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>眇能视，利幽人之贞。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>利幽人之贞，未变常也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>归妹以须，反归以娣。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>归妹以须，未当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>归妹愆期，迟归有时。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>愆期之志，有待而行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>帝乙归妹，其君之袂，不如其娣之袂良，月几望，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>帝乙归妹，不如其娣之袂良也。其位在中，以贵行也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_GuiMei_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_GuiMei"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>女承筐无实，士刲羊无血，无攸利。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>上六无实，承虚筐也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">归妹_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>浚恒，贞凶，无攸利。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>浚恒之凶，始求深也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>悔亡。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二悔亡，能久中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>不恒其德，或承之羞，贞吝。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>不恒其德，无所容也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>田无禽。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>久非其位，安得禽也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>恒其德，贞，妇人吉，夫子凶。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>妇人贞吉，从一而终也。夫子制义，从妇凶也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Heng_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Heng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>振恒，凶。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>振恒在上，大无功也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">恒_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>用拯马壮，吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>初六之吉，顺也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>涣奔其机，悔亡。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>涣奔其机，得愿也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>涣其躬，无悔。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>涣其躬，志在外也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>涣其群，元吉。涣有丘，匪夷所思。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>涣其群元吉，光大也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>涣汗其大号，涣王居，无咎。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>王居无咎，正位也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Huan_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Huan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>涣其血，去逖出，无咎。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>涣其血，远害也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">涣_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>曳其轮，濡其尾，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>曳其轮，义无咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>妇丧其茀，勿逐，七日得。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>七日得，以中道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>高宗伐鬼方，三年克之，小人勿用。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>三年克之，惫也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>繻有衣袽，终日戒。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>终日戒，有所疑也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>东邻杀牛，不如西邻之禴祭，实受其福。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>东邻杀牛，不如西邻之时也。实受其福，吉大来也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiJi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>濡其首，厉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>濡其首厉，何可久也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">既济_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>闲有家，悔亡。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>闲有家，志未变也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>无攸遂，在中馈，贞吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>六二之吉，顺以巽也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>家人嗃嗃，悔厉吉；妇子嘻嘻，终吝。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>家人嗃嗃，未失也。妇子嘻嘻，失家节也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>富家，大吉。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>富家大吉，顺在位也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>王假有家，勿恤吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>王假有家，交相爱也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_JiaRen_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_JiaRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>有孚威如，终吉。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>威如之吉，反身之谓也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">家人_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>鸿渐于干，小子厉，有言，无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>小子之厉，义无咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>鸿渐于磐，饮食衎衎，吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>饮食衎衎，不素饱也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>夫征不复，离群丑也。妇孕不育，失其道也。利用御寇，顺相保也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>鸿渐于木，或得其桷，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>或得其桷，顺以巽也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>鸿渐于陵，妇三岁不孕，终莫之胜，吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>终莫之胜吉，得所愿也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>鸿渐于陆，其羽可用为仪，吉。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>其羽可用为仪吉，不可乱也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">渐_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>往蹇，来誉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>往蹇来誉，宜待也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>王臣蹇蹇，匪躬之故。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>王臣蹇蹇，终无尤也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>往蹇来反。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>往蹇来反，内喜之也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>往蹇来连。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>往蹇来连，当位实也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>大蹇朋来。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>大蹇朋来，以中节也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jian_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>往蹇来硕，吉；利见大人。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>往蹇来硕，志在内也。利见大人，以从贵也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蹇_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>不出户庭，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>不出户庭，知通塞也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">节_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>不出门庭，凶。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>不出门庭凶，失时极也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">节_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>不节若，则嗟若，无咎。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>不节之嗟，又谁咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">节_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>安节，亨。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>安节之亨，承上道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">节_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>甘节，吉；往有尚。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>甘节之吉，居位中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">节_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jie_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>苦节，贞凶，悔亡。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>苦节贞凶，其道穷也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">节_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>晋如，摧如，贞吉。罔孚，裕无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>晋如摧如，独行正也。裕无咎，未受命也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>晋如，愁如，贞吉。受兹介福，于其王母。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>受兹介福，以中正也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>众允，悔亡。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>众允之志，上行也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>晋如鼫鼠，贞厉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>鼫鼠贞厉，位不当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>悔亡，失得勿恤，往吉无不利。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>失得勿恤，往有庆也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jin_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>晋其角，维用伐邑，厉吉无咎，贞吝。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>维用伐邑，道未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">晋_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>井泥不食，旧井无禽。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>井泥不食，下也。旧井无禽，时舍也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">井_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>井谷射鲋，瓮敝漏。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>井谷射鲋，无与也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">井_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>井渫不食，为我心恻，可用汲，王明，并受其福。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>井渫不食，行恻也。求王明，受福也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">井_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>井甃，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>井甃无咎，修井也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">井_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>井洌，寒泉食。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>寒泉之食，中正也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">井_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Jing_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Jing"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>井收勿幕，有孚元吉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>元吉在上，大成也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">井_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>习坎，入于坎窞，凶。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>习坎入坎，失道凶也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>坎有险，求小得。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>求小得，未出中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>来之坎坎，险且枕，入于坎窞，勿用。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>来之坎坎，终无功也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>樽酒簋贰，用缶，纳约自牖，终无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>樽酒簋贰，刚柔际也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>坎不盈，只既平，无咎。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>坎不盈，中未大也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kan_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kan"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>系用徽纆，寘于丛棘，三岁不得，凶。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>上六失道，凶三岁也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坎_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>悔亡，丧马勿逐，自复；见恶人，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>见恶人，以辟咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>遇主于巷，无咎。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>遇主于巷，未失道也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>见舆曳，其牛掣，其人天且劓，无初有终。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>见舆曳，位不当也。无初有终，遇刚也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>睽孤，遇元夫，交孚，厉无咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>交孚无咎，志行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>悔亡，厥宗噬肤，往何咎。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>厥宗噬肤，往有庆也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kui_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>睽孤，见豕负涂，载鬼一车，先张之弧，后说之弧，匪寇婚媾，往遇雨则吉。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>遇雨之吉，群疑亡也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">睽_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>臀困于株木，入于幽谷，三岁不觌。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>入于幽谷，幽不明也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">困_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>困于酒食，朱绂方来，利用亨祀，征凶，无咎。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>困于酒食，中有庆也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">困_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>困于石，据于蒺藜，入于其宫，不见其妻，凶。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>据于蒺藜，乘刚也。入于其宫，不见其妻，不祥也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">困_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>来徐徐，困于金车，吝，有终。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>来徐徐，志在下也。虽不当位，有与也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">困_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>劓刖，困于赤绂，乃徐有说，利用祭祀。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>劓刖，志未得也。乃徐有说，以中直也。利用祭祀，受福也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">困_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>困于葛藟，于臲卼，曰动悔。有悔，征吉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>困于葛藟，未当也。动悔有悔，吉行也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">困_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>履霜，坚冰至。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>履霜坚冰，阴始凝也。驯致其道，至坚冰也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>直方大，不习无不利。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>六二之动，直以方也。不习无不利，地道光也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>含章可贞。或从王事，无成有终。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>含章可贞，以时发也。或从王事，知光大也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>括囊，无咎无誉。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>括囊无咎，慎不害也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>黄裳，元吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>黄裳元吉，文在中也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>龙战于野，其血玄黄。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>龙战于野，其道穷也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Kun_7">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Kun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</yaoPosition>
        <yaoText>利永贞。</yaoText>
        <yaoTitle>用六</yaoTitle>
        <yaoXiang>用六永贞，以大终也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">坤_用六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>履错然，敬之无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>履错之敬，以辟咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">离_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>黄离，元吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>黄离元吉，得中道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">离_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>日昃之离，不鼓缶而歌，则大耋之嗟，凶。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>日昃之离，何可久也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">离_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>突如其来如，焚如，死如，弃如。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>突如其来如，无所容也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">离_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>出涕沱若，戚嗟若，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五之吉，离王公也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">离_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Li_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Li_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Li"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>王用出征，有嘉折首，获匪其丑，无咎。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>王用出征，以正邦也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">离_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>咸临，贞吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>咸临贞吉，志行正也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">临_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>咸临，吉无不利。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>咸临吉无不利，未顺命也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">临_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>甘临，无攸利。既忧之，无咎。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>甘临，位不当也。既忧之，咎不长也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">临_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>至临，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>至临无咎，位当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">临_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>知临，大君之宜，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>大君之宜，行中之谓也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">临_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lin_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lin"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>敦临，吉无咎。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>敦临之吉，志在内也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">临_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>旅琐琐，斯其所取灾。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>旅琐琐，志穷灾也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>旅即次，怀其资，得童仆贞。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>得童仆贞，终无尤也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>旅焚其次，丧其童仆，贞厉。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>旅焚其次，亦以伤矣。以旅与下，其义丧也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>旅于处，得其资斧，我心不快。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>旅于处，未得位也。得其资斧，心未快也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>射雉一矢亡，终以誉命。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>终以誉命，上逮也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>鸟焚其巢，旅人先笑后号啕。丧牛于易，凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>以旅在上，其义焚也。丧牛于易，终莫之闻也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">旅_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>素履，往无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>素履之往，独行愿也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">履_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>履道坦坦，幽人贞吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>幽人贞吉，中不自乱也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">履_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>眇能视，跛能履，履虎尾，咥人，凶。武人为于大君。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>眇能视，不足以有明也。跛能履，不足以与行也。咥人之凶，位不当也。武人为于大君，志刚也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">履_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>履虎尾，愬愬终吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>愬愬终吉，志行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">履_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>夬履，贞厉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>夬履贞厉，位正当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">履_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Lv_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Lv"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>视履考祥，其旋元吉。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>元吉在上，大有庆也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">履_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>发蒙，利用刑人，用说桎梏，以往吝。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>利用刑人，以正法也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>包蒙吉，纳妇吉，子克家。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>子克家，刚柔接也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>勿用取女，见金夫，不有躬，无攸利。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>勿用取女，行不顺也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>困蒙，吝。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>困蒙之吝，独远实也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>童蒙，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>童蒙之吉，顺以巽也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Meng_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Meng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>击蒙，不利为寇，利御寇。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>利用御寇，上下顺也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">蒙_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>明夷于飞，垂其翼。君子于行，三日不食，有攸往，主人有言。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>君子于行，义不食也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>明夷，夷于左股，用拯马壮，吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>六二之吉，顺以则也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>明夷于南狩，得其大首，不可疾贞。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>南狩之志，乃大得也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>入于左腹，获明夷之心，于出门庭。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>入于左腹，获心意也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>箕子之明夷，利贞。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>箕子之贞，明不可息也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_MingYi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_MingYi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>不明晦，初登于天，后入于地。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>初登于天，照四国也。后入于地，失则也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">明夷_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>拔茅茹，以其汇，贞吉，亨。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>拔茅贞吉，志在君也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">否_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>包承。小人吉，大人否亨。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>大人否亨，不乱群也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">否_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>包羞。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>包羞，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">否_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>有命无咎，畴离祉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>有命无咎，志行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">否_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>休否，大人吉。其亡其亡，系于苞桑。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>大人之吉，位正当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">否_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Pi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Pi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>倾否，先否后喜。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>否终则倾，何可长也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">否_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>谦谦君子，用涉大川，吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>谦谦君子，卑以自牧也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>鸣谦，贞吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>鸣谦贞吉，中心得也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>劳谦，君子有终，吉。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>劳谦君子，万民服也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>无不利，撝谦。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>无不利撝谦，不违则也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>不富以其邻，利用侵伐，无不利。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>利用侵伐，征不服也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>鸣谦，利用行师，征邑国。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>鸣谦，志未得也。可用行师，征邑国也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">谦_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>潜龙勿用。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>潜龙勿用，阳在下也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>见龙在田，利见大人。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>见龙在田，德施普也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>君子终日乾乾，夕惕若厉，无咎。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>终日乾乾，反复道也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>或跃在渊，无咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>或跃在渊，进无咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>飞龙在天，利见大人。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>飞龙在天，大人造也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>亢龙有悔。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>亢龙有悔，盈不可久也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Qian_7">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Qian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</yaoPosition>
        <yaoText>见群龙无首，吉。</yaoText>
        <yaoTitle>用九</yaoTitle>
        <yaoXiang>用九，天德不可为首也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">乾_用九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>允升，大吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>允升大吉，上合志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">升_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>孚乃利用禴，无咎。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二之孚，有喜也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">升_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>升虚邑。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>升虚邑，无所疑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">升_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>王用亨于岐山，吉无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>王用亨于岐山，顺事也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">升_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贞吉，升阶。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>贞吉升阶，大得志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">升_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sheng_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sheng"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>冥升，利于不息之贞。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>冥升在上，消不富也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">升_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>屦校灭趾，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>屦校灭趾，不行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>噬肤灭鼻，无咎。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>噬肤灭鼻，乘刚也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>噬腊肉，遇毒；小吝，无咎。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>遇毒，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>噬干胏，得金矢，利艰贞，吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>利艰贞吉，未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>噬干肉，得黄金，贞厉，无咎。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>贞厉无咎，得当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ShiHe_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ShiHe"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>何校灭耳，凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>何校灭耳，聪不明也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">噬嗑_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>师出以律，否臧凶。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>师出以律，失律凶也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">师_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>在师中吉，无咎，王三锡命。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>在师中吉，承天宠也。王三锡命，怀万邦也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">师_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>师或舆尸，凶。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>师或舆尸，大无功也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">师_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>师左次，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>左次无咎，未失常也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">师_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>长子帅师，以中行也。弟子舆尸，使不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">师_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Shi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Shi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>大君有命，开国承家，小人勿用。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>大君有命，以正功也。小人勿用，必乱邦也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">师_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>不永所事，小有言，终吉。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>不永所事，讼不可长也。虽小有言，其辩明也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>不克讼，归而逋，其邑人三百户，无眚。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>不克讼，归逋窜也。自下讼上，患至掇也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>食旧德，贞厉，终吉。或从王事，无成。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>食旧德，从上吉也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>不克讼，复即命，渝安贞，吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>复即命，渝安贞，不失也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>讼，元吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>讼元吉，以中正也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Song_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Song_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Song"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>或锡之鞶带，终朝三褫之。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>以讼受服，亦不足敬也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">讼_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>官有渝，贞吉。出门交有功。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>官有渝，从正吉也。出门交有功，不失也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">随_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>系小子，失丈夫。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>系小子，弗兼与也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">随_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>系丈夫，失小子。随有求得，利居贞。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>系丈夫，志舍下也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">随_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>随有获，贞凶。有孚在道，以明，何咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>随有获，其义凶也。有孚在道，明功也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">随_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>孚于嘉，吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>孚于嘉吉，位正中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">随_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sui_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sui"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>拘系之，乃从维之。王用亨于西山。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>拘系之，上穷也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">随_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>已事遄往，无咎，酌损之。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>已事遄往，尚合志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">损_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>利贞，征凶，弗损益之。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二利贞，中以为志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">损_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>三人行，则损一人；一人行，则得其友。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>一人行，三则疑也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">损_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>损其疾，使遄有喜，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>损其疾，亦可喜也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">损_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>或益之十朋之龟，弗克违，元吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五元吉，自上佑也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">损_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Sun_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Sun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>弗损益之，无咎，贞吉，利有攸往，得臣无家。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>弗损益之，大得志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">损_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>拔茅茹，以其汇，征吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>拔茅征吉，志在外也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>包荒，用冯河，不遐遗，朋亡，得尚于中行。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>包荒，得尚于中行，以光大也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>无平不陂，无往不复，艰贞无咎。勿恤其孚，于食有福。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>无往不复，天地际也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>翩翩不富，以其邻，不戒以孚。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>翩翩不富，皆失实也。不戒以孚，中心愿也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>帝乙归妹，以祉元吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>以祉元吉，中以行愿也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Tai_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Tai"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>城复于隍，勿用师。自邑告命，贞吝。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>城复于隍，其命乱也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">泰_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>同人于门，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>出门同人，又谁咎也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>同人于宗，吝。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>同人于宗，吝道也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>伏戎于莽，升其高陵，三岁不兴。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>伏戎于莽，敌刚也。三岁不兴，安行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>乘其墉，弗克攻，吉。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>乘其墉，义弗克也。其吉，则困而反则也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>同人，先号啕而后笑。大师克相遇。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>同人之先，以中直也。大师相遇，言相克也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_TongRen_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_TongRen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>同人于郊，无悔。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>同人于郊，志未得也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">同人_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>濡其尾，吝。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>濡其尾，亦不知极也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>曳其轮，贞吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二贞吉，中以行正也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>未济，征凶，利涉大川。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>未济征凶，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>贞吉，悔亡，震用伐鬼方，三年有赏于大国。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>贞吉悔亡，志行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贞吉，无悔，君子之光，有孚，吉。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>君子之光，其晖吉也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WeiJi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WeiJi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>有孚于饮酒，无咎，濡其首，有孚失是。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>饮酒濡首，亦不知节也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">未济_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>无妄，往吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>无妄之往，得志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>不耕获，不菑畲，则利有攸往。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>不耕获，未富也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>无妄之灾，或系之牛，行人之得，邑人之灾。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>行人得牛，邑人灾也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>可贞，无咎。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>可贞无咎，固有之也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>无妄之疾，勿药有喜。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>无妄之药，不可试也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_WuWang_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_WuWang"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>无妄，行有眚，无攸利。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>无妄之行，穷之灾也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">无妄_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>咸其拇。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>咸其拇，志在外也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>咸其腓，凶，居吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>虽凶居吉，顺不害也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>咸其股，执其随，往吝。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>咸其股，亦不处也。志在随人，所执下也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>贞吉悔亡，憧憧往来，朋从尔思。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>贞吉悔亡，未感害也。憧憧往来，未光大也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>咸其脢，无悔。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>咸其脢，志末也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xian_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xian"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>咸其辅颊舌。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>咸其辅颊舌，滕口说也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">咸_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>飞鸟以凶。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>飞鸟以凶，不可如何也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>过其祖，遇其妣；不及其君，遇其臣；无咎。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>不及其君，臣不可过也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>弗过防之，从或戕之，凶。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>从或戕之，凶如何也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>无咎，弗过遇之。往厉必戒，勿用永贞。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>弗过遇之，位不当也。往厉必戒，终不可长也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>密云不雨，自我西郊，公弋取彼在穴。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>密云不雨，已上也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoGuo_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoGuo"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>弗遇过之，飞鸟离之，凶，是谓灾眚。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>弗遇过之，已亢也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">小过_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>复自道，何其咎，吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>复自道，其义吉也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>牵复，吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>牵复在中，亦不自失也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>舆说辐，夫妻反目。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>夫妻反目，不能正室也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>有孚，血去惕出，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>有孚惕出，上合志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>有孚挛如，富以其邻。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>有孚挛如，不独富也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_XiaoXu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_XiaoXu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>既雨既处，尚德载，妇贞厉。月几望，君子征凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>既雨既处，德积载也。君子征凶，有所疑也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">小畜_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>无咎。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>刚柔之际，义无咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">解_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>田获三狐，得黄矢，贞吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>九二贞吉，得中道也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">解_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>负且乘，致寇至，贞吝。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>负且乘，亦可丑也。自我致戎，又谁咎也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">解_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>解而拇，朋至斯孚。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>解而拇，未当位也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">解_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>君子维有解，吉；有孚于小人。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>君子有解，小人退也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">解_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xie_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xie"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>公用射隼于高墉之上，获之，无不利。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>公用射隼，以解悖也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">解_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>需于郊，利用恒，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>需于郊，不犯难行也。利用恒无咎，未失常也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">需_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>需于沙，小有言，终吉。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>需于沙，衍在中也。虽小有言，以吉终也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">需_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>需于泥，致寇至。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>需于泥，灾在外也。自我致寇，敬慎不败也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">需_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>需于血，出自穴。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>需于血，顺以听也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">需_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>需于酒食，贞吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>酒食贞吉，以中正也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">需_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>入于穴，有不速之客三人来，敬之终吉。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>不速之客来，敬之终吉。虽不当位，未大失也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">需_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>进退，利武人之贞。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>进退，志疑也。利武人之贞，志治也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>巽在床下，用史巫纷若，吉无咎。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>纷若之吉，得中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>频巽，吝。</yaoText>
        <yaoTitle>九三</yaoTitle>
        <yaoXiang>频巽之吝，志穷也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_九三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>悔亡，田获三品。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>田获三品，有功也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贞吉悔亡，无不利。无初有终，先庚三日，后庚三日，吉。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>九五之吉，位正中也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Xun_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Xun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>巽在床下，丧其资斧，贞凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>巽在床下，上穷也。丧其资斧，正乎凶也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">巽_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>利用为大作，元吉，无咎。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>元吉无咎，下不厚事也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">益_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>或益之十朋之龟，弗克违，永贞吉。王用享于帝，吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>或益之，自外来也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">益_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>益之用凶事，无咎。有孚中行，告公用圭。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>益用凶事，固有之也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">益_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>中行，告公从。利用为依迁国。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>告公从，以益志也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">益_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>有孚惠心，勿问元吉。有孚惠我德。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>有孚惠心，勿问之矣。惠我德，大得志也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">益_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi2_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi2"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>莫益之，或击之，立心勿恒，凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>莫益之，偏辞也。或击之，自外来也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">益_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>舍尔灵龟，观我朵颐，凶。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>观我朵颐，亦不足贵也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>颠颐，拂经，于丘颐，征凶。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>六二征凶，行失类也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>拂颐，贞凶，十年勿用，无攸利。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>十年勿用，道大悖也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>颠颐吉，虎视眈眈，其欲逐逐，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>颠颐之吉，上施光也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>拂经，居贞吉，不可涉大川。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>居贞之吉，顺以从上也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yi_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yi"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>由颐，厉吉，利涉大川。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>由颐厉吉，大有庆也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">颐_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>鸣豫，凶。</yaoText>
        <yaoTitle>初六</yaoTitle>
        <yaoXiang>初六鸣豫，志穷凶也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_初六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>介于石，不终日，贞吉。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>不终日贞吉，以中正也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>盱豫，悔。迟有悔。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>盱豫有悔，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>由豫，大有得。勿疑。朋盍簪。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>由豫大有得，志大行也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>贞疾，恒不死。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>六五贞疾，乘刚也。恒不死，中未亡也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Yu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Yu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>冥豫成，有渝无咎。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>冥豫在上，何可长也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">豫_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>震来虩虩，后笑言哑哑，吉。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>震来虩虩，恐致福也。笑言哑哑，后有则也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">震_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>震来厉，亿丧贝，跻于九陵，勿逐，七日得。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>震来厉，乘刚也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">震_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>震苏苏，震行无眚。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>震苏苏，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">震_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>震遂泥。</yaoText>
        <yaoTitle>九四</yaoTitle>
        <yaoXiang>震遂泥，未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">震_九四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>震往来厉，亿无丧，有事。</yaoText>
        <yaoTitle>六五</yaoTitle>
        <yaoXiang>震往来厉，危行也。其事在中，大无丧也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">震_六五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhen_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhen"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>震索索，中未得也。虽凶无咎，畏邻戒也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">震_上六</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>虞吉，有它不燕。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>初九虞吉，志未变也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>鸣鹤在阴，其子和之，我有好爵，吾与尔靡之。</yaoText>
        <yaoTitle>九二</yaoTitle>
        <yaoXiang>其子和之，中心愿也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_九二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>得敌，或鼓或罢，或泣或歌。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>或鼓或罢，位不当也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>月几望，马匹亡，无咎。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>马匹亡，绝类上也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>有孚挛如，无咎。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>有孚挛如，位正当也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_ZhongFu_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_ZhongFu"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>翰音登于天，贞凶。</yaoText>
        <yaoTitle>上九</yaoTitle>
        <yaoXiang>翰音登于天，何可长也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">中孚_上九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</yaoPosition>
        <yaoText>磐桓，利居贞，利建侯。</yaoText>
        <yaoTitle>初九</yaoTitle>
        <yaoXiang>虽磐桓，志行正也。以贵下贱，大得民也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_初九</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</yaoPosition>
        <yaoText>屯如邅如，乘马班如。匪寇婚媾，女子贞不字，十年乃字。</yaoText>
        <yaoTitle>六二</yaoTitle>
        <yaoXiang>六二之难，乘刚也。十年乃字，反常也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_六二</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_3">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</yaoPosition>
        <yaoText>即鹿无虞，惟入于林中，君子几不如舍，往吝。</yaoText>
        <yaoTitle>六三</yaoTitle>
        <yaoXiang>即鹿无虞，以从禽也。君子舍之，往吝穷也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_六三</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_4">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</yaoPosition>
        <yaoText>乘马班如，求婚媾，往吉，无不利。</yaoText>
        <yaoTitle>六四</yaoTitle>
        <yaoXiang>求而往，明也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_六四</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_5">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</yaoPosition>
        <yaoText>屯其膏，小贞吉，大贞凶。</yaoText>
        <yaoTitle>九五</yaoTitle>
        <yaoXiang>屯其膏，施未光也。</yaoXiang>
        <yaoYinYang>阳</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_九五</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/86189/ontologies/yijing#y_Zhun_6">
        <rdf:type rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#Yao"/>
        <belongsToGua rdf:resource="http://www.semanticweb.org/86189/ontologies/yijing#h_Zhun"/>
        <yaoPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</yaoPosition>
        <yaoText>乘马班如，泣血涟如。</yaoText>
        <yaoTitle>上六</yaoTitle>
        <yaoXiang>泣血涟如，何可长也。</yaoXiang>
        <yaoYinYang>阴</yaoYinYang>
        <rdfs:label xml:lang="zh">屯_上六</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>



